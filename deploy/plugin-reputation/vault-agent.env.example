DATABASE_NETWORK=fluxgram-database
MONITORING_NETWORK=fluxgram-monitoring
PLUGIN_REPUTATION_AUTHORITY_KEY_ID=p256:replace-with-authority-key-id
PLUGIN_REPUTATION_API_DATABASE_URL_FILE=/run/fluxgram/public-api/database-url
PLUGIN_REPUTATION_API_IMAGE=registry.example/fluxgram-backend@sha256:replace-with-image-digest
PLUGIN_REPUTATION_DATABASE_URL_FILE=/run/fluxgram/publisher/database-url
PLUGIN_REPUTATION_PUBLISHER_IMAGE=registry.example/fluxgram-backend@sha256:replace-with-image-digest
PLUGIN_REPUTATION_OPERATIONS_ALLOWED_NETWORK=172.30.0.0/24
PLUGIN_REPUTATION_WORKER_ID=publisher-1
PUBLIC_NETWORK=fluxgram-public
REPUTATION_API_TRUSTED_PROXY_NETWORK=172.31.0.0/24
VAULT_AGENT_BOOTSTRAP_DIR=/run/fluxgram/vault-agent/bootstrap
VAULT_AGENT_CA_FILE=/etc/fluxgram/vault-tls/vault-ca.pem
VAULT_AGENT_TOKEN_DIR=/run/fluxgram/vault-agent/secrets
VAULT_NETWORK=fluxgram-vault
